/* 天龙防骗指南 */
.page {
  padding: 20rpx;
  background: #ffffff;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 主标题 */
.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
  text-align: center;
  margin: 10rpx 0 24rpx;
}

/* 顶部警示横幅：浅红背景、红色加粗、12rpx 圆角、上下 20rpx 内边距、居中 */
.warn-banner {
  background: #fdeaea;
  color: #d93636;
  font-weight: 700;
  font-size: 26rpx;
  line-height: 1.7;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

/* 骗局列表 */
.scam-list {
  display: flex;
  flex-direction: column;
}

/* 单条骗局卡片：浅灰背景、12rpx 圆角、20rpx 内边距、上下 15rpx 间距 */
.scam-card {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 15rpx;
}

.scam-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 10rpx;
}

.scam-index {
  color: #d93636;
  margin-right: 6rpx;
}

.scam-body {
  font-size: 26rpx;
  color: #333;
  line-height: 1.7;
}

/* 重点文字：核心套路 / 铁律 加粗标红、标蓝 */
.hl-red {
  color: #d93636;
  font-weight: 700;
}

.hl-blue {
  color: #1a6cff;
  font-weight: 700;
}

/* 核心防骗总结：浅绿背景圆角卡片 */
.summary {
  background: #e8f8ee;
  border-radius: 12rpx;
  padding: 20rpx;
  margin: 10rpx 0 24rpx;
}

.summary-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 14rpx;
}

.summary-item {
  font-size: 26rpx;
  color: #2a7d4f;
  line-height: 1.8;
}

/* 底部备注：小号灰色、居中 */
.footer-note {
  font-size: 22rpx;
  color: #999;
  text-align: center;
  line-height: 1.6;
  padding: 10rpx 0 30rpx;
}
