.page-container {
  padding: 24rpx 32rpx 60rpx;
  background: #f5f6fa;
  min-height: 100vh;
  box-sizing: border-box;
}

.tip {
  font-size: 26rpx;
  color: #888;
  line-height: 1.6;
  margin: 8rpx 0 24rpx;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 28rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.field-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin: 8rpx 0 16rpx;
}
.field-label:first-child {
  margin-top: 0;
}

/* 类型分段 */
.type-tabs {
  display: flex;
  background: #eef0f7;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}
.type-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #555;
  border-radius: 10rpx;
}
.type-tab.active {
  background: #4a6cf7;
  color: #fff;
  font-weight: 600;
}

/* 内容输入 */
.content-input {
  width: 100%;
  height: 240rpx;
  background: #f7f8fc;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #1a1a2e;
  box-sizing: border-box;
  line-height: 1.5;
}
.counter {
  text-align: right;
  font-size: 22rpx;
  color: #999;
  margin: 8rpx 0 24rpx;
}

/* 联系方式 */
.contact-input {
  width: 100%;
  height: 80rpx;
  background: #f7f8fc;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #1a1a2e;
  box-sizing: border-box;
  margin-bottom: 32rpx;
}

/* 提交按钮 */
.submit-btn {
  margin-top: 8rpx;
}
.btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  border: none;
  padding: 0;
}
.btn::after {
  border: none;
}
.btn-primary {
  background: linear-gradient(135deg, #4a6cf7, #6c8cff);
  color: #fff;
}
.btn-primary:active {
  opacity: 0.85;
}

/* 底部原生模板广告位（随页面滚动） */
.ad-slot {
  margin-top: 24rpx;
}
