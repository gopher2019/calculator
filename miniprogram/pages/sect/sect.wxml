<!--sect.wxml-->
<scroll-view class="scrollarea" scroll-y>
  <view class="page-container">

    <!-- 顶部标题 -->
    <view class="page-header">
      <view class="page-title">门派属性系数</view>
    </view>

    <view class="page-intro">怀旧天龙全门派冰火玄毒伤害系数与五维潜能成长查询，随时翻看。</view>

    <!-- Tab 切换栏 -->
    <view class="tab-bar">
      <view class="tab {{activeTab === 0 ? 'active' : ''}}" data-tab="0" bindtap="switchTab">门派属性攻击系数</view>
      <view class="tab {{activeTab === 1 ? 'active' : ''}}" data-tab="1" bindtap="switchTab">门派潜能成长</view>
    </view>

    <!-- 原生模板广告位（位于两个 Tab 下方，高度动态适配） -->
    <view class="ad-slot" hidden="{{adHidden}}" style="min-height: {{adReserve}}rpx;">
      <ad unit-id="adunit-ae5db0d5b9b71f5d" ad-type="card" ad-theme="light" bindload="onAdLoad" binderror="onAdError"></ad>
    </view>

    <!-- Tab1：门派属性攻击系数（冰火玄毒） -->
    <view class="tab-panel" wx:if="{{activeTab === 0}}">
      <view class="elem-card" wx:for="{{elemSects}}" wx:key="name">
        <view class="elem-head">{{item.name}}</view>
        <view class="elem-row">
          <view class="elem-item" wx:for="{{item.attrs}}" wx:for-item="attr" wx:key="name">
            <text class="elem-dot dot-{{attr.key}}"></text>
            <text class="elem-label">{{attr.name}}</text>
            <text class="elem-val">{{attr.value}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- Tab2：门派潜能成长（五维） -->
    <view class="tab-panel" wx:if="{{activeTab === 1}}">
      <view class="sect-card" wx:for="{{potentials}}" wx:key="name">
        <view class="sect-card-head">{{item.name}}</view>
        <view class="pot-row">
          <text class="pot-name">1力量</text>
          <text class="pot-val">{{item.str}} 外攻</text>
        </view>
        <view class="pot-row">
          <text class="pot-name">1灵气</text>
          <text class="pot-val">{{item.int}} 内功</text>
        </view>
        <view class="pot-row">
          <text class="pot-name">1体力</text>
          <text class="pot-val">{{item.con}} 血上限</text>
        </view>
        <view class="pot-row">
          <text class="pot-name">1定力</text>
          <text class="pot-val">{{item.fix}} 气上限</text>
        </view>
        <view class="pot-row">
          <text class="pot-name">1身法</text>
          <text class="pot-val">{{item.agi}} 命中、{{item.dodge}} 闪避、{{item.crit}} 会心&会防</text>
        </view>
      </view>
    </view>

    <view class="bottom-spacer"></view>
  </view>
</scroll-view>
