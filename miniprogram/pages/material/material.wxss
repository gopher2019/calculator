page {
  height: 100vh;
  background-color: #f5f6fa;
}

.page-container {
  padding: 24rpx 32rpx;
  padding-bottom: 60rpx;
}

/* ===== 顶部 Tab 分段控件（与珍兽页倍率表 Tab 一致） ===== */
.rate-tabs {
  display: flex;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  background: #f0f0f5;
}

.rate-tab {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  font-size: 28rpx;
  color: #666;
  transition: all 0.2s;
}

.rate-tab.active {
  background: #4a6cf7;
  color: #fff;
  border-radius: 12rpx;
  font-weight: 600;
}

/* ===== 区块卡片 ===== */
.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* ===== 输入组（标签在上，输入框在下） ===== */
.input-group {
  margin-bottom: 24rpx;
}

.input-group:last-of-type {
  margin-bottom: 0;
}

.input-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.input-field {
  width: 100%;
  height: 80rpx;
  background: #f7f8fc;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #1a1a2e;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: border-color 0.2s;
}

.input-field:focus {
  border-color: #4a6cf7;
  background: #fff;
}

/* ===== 开关（与珍兽页一致的自绘开关） ===== */
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  margin-bottom: 24rpx;
}

.switch-label {
  display: flex;
  flex-direction: column;
  font-size: 28rpx;
  color: #1a1a2e;
}

.switch-hint {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.switch-track {
  width: 88rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: #ddd;
  display: flex;
  align-items: center;
  padding: 0 4rpx;
  transition: background 0.25s;
  flex-shrink: 0;
}

.switch-track.active {
  background: #4a6cf7;
}

.switch-thumb {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.15);
  transition: transform 0.25s;
}

.switch-thumb.active {
  transform: translateX(40rpx);
}

/* ===== 计算按钮（蓝色渐变胶囊，与主按钮一致） ===== */
.calc-btn {
  margin: 30rpx 0 10rpx;
}

.btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  border: none;
  padding: 0;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #4a6cf7, #6c8cff);
  color: #fff;
}

.btn-primary:active {
  opacity: 0.85;
}

/* ===== 结果区（蓝色左侧高亮，首行主色加粗） ===== */
.result-section {
  border-left: 6rpx solid #4a6cf7;
  margin-top: 16rpx;
  padding: 8rpx 20rpx;
  background: #f7f9ff;
  border-radius: 0 12rpx 12rpx 0;
}

.result-line {
  padding: 14rpx 0;
  font-size: 30rpx;
  color: #1a1a2e;
  font-weight: 600;
  border-bottom: 1rpx solid #eef0f7;
}

.result-line:last-child {
  border-bottom: none;
}

.result-line:first-child {
  color: #4a6cf7;
  font-size: 36rpx;
  font-weight: 700;
}

/* ===== 顶部广告位（内联，随页面滚动） ===== */
.ad-slot {
  margin-bottom: 24rpx;
}

/* ===== 多物品卡片 ===== */
.item-card {
  background: #f7f8fc;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}
.item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.item-index {
  font-size: 26rpx;
  font-weight: 600;
  color: #4a6cf7;
}
.item-del {
  font-size: 32rpx;
  color: #999;
  padding: 0 8rpx;
}
.item-del:active {
  color: #ff5a5f;
}
.input-row {
  display: flex;
}
.input-row .input-group {
  flex: 1;
  margin-bottom: 12rpx;
}
.input-row .input-group + .input-group {
  margin-left: 16rpx;
}
/* 物品行：标签与输入框同一行 */
.input-group.inline {
  display: flex;
  align-items: center;
}
.input-group.inline .input-label {
  margin-bottom: 0;
  margin-right: 12rpx;
  white-space: nowrap;
  flex-shrink: 0;
}
.input-group.inline .input-field {
  width: auto;
  flex: 1;
}
.item-sub {
  font-size: 26rpx;
  color: #4a6cf7;
  margin-top: 4rpx;
}
.add-btn {
  text-align: center;
  font-size: 28rpx;
  color: #4a6cf7;
  background: #eef2ff;
  border-radius: 12rpx;
  padding: 20rpx 0;
  margin-bottom: 24rpx;
}
.add-btn:active {
  opacity: 0.8;
}

/* ===== 结果明细（逐项） ===== */
.result-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 28rpx;
  color: #333;
  border-bottom: 1rpx solid #eef0f7;
}
.ri-sub {
  color: #4a6cf7;
  font-weight: 600;
}

/* 结果操作（复制 / 清空） */
.result-actions {
  display: flex;
  margin-bottom: 12rpx;
}
.result-action {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #4a6cf7;
  background: #eef2ff;
  border-radius: 10rpx;
  padding: 14rpx 0;
}
.result-action + .result-action {
  margin-left: 16rpx;
}
.result-action:active {
  opacity: 0.8;
}
.result-item:active {
  background: #eef2ff;
}
