/* 怀旧骚操作 */
.page {
  padding: 20rpx;
  background: #ffffff;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 底部悬浮原生模板广告位（固定底部，不随内容滚动） */
.ad-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  padding: 0 20rpx;
  padding-bottom: env(safe-area-inset-bottom, 0rpx);
  background: #ffffff;
}

/* 顶部浅蓝提示栏 */
.tip-banner {
  background: #edf4ff;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: #2a5bb5;
  line-height: 1.7;
  margin-bottom: 20rpx;
}

/* 独立技巧卡片 */
.card {
  background: #f5f5f5;
  border-radius: 12rpx;
  margin: 20rpx 0;
  padding: 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 14rpx;
}

.card-body {
  font-size: 26rpx;
  color: #333;
  line-height: 1.8;
}

.line {
  margin-bottom: 6rpx;
}

/* 普通文本 */
.txt {
  color: #333;
}

/* 代码 / 指令：蓝色加粗 + 浅蓝底胶囊，可点击复制 */
.code {
  color: #1a6cff;
  font-weight: 700;
  background: #e6efff;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin: 0 4rpx;
}

/* 关键数值：蓝色加粗 */
.num {
  color: #1a6cff;
  font-weight: 700;
}

/* 底部备注 */
.footer-note {
  font-size: 22rpx;
  color: #999;
  text-align: center;
  line-height: 1.6;
  padding: 20rpx 0 30rpx;
}
