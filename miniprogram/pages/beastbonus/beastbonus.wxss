/**beastbonus.wxss**/
page {
  background: linear-gradient(180deg, #f7f1e3 0%, #efe5d2 100%);
  min-height: 100vh;
}

.equip-page {
  padding: 24rpx 32rpx 80rpx;
}

/* ===== 顶部标题 + 说明 ===== */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 8rpx 28rpx;
}
.title {
  font-family: "STKaiti", "KaiTi", "Kaiti SC", "楷体", serif;
  font-size: 44rpx;
  font-weight: 700;
  color: #3a2f25;
  letter-spacing: 4rpx;
}
.help-btn {
  font-size: 26rpx;
  color: #8a5a2b;
  border: 2rpx solid #b98e4e;
  border-radius: 30rpx;
  padding: 8rpx 28rpx;
  background: rgba(185, 142, 78, 0.1);
}
.help-btn:active {
  opacity: 0.7;
}

/* ===== 下拉筛选（倍率 / 等级 / 资质项目） ===== */
.filter-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}
.filter-picker.half {
  flex: 1;
}
.filter-picker.full {
  margin-bottom: 28rpx;
}
.filter-box {
  display: flex;
  align-items: center;
  height: 80rpx;
  padding: 0 28rpx;
  background: #fffdf8;
  border: 2rpx solid #2f7d4f;
  border-radius: 40rpx;
  font-size: 28rpx;
}
.filter-label {
  color: #6b4f2a;
  font-weight: 600;
  flex-shrink: 0;
}
.filter-value {
  flex: 1;
  min-width: 0;
  text-align: right;
  margin-right: 16rpx;
  color: #2f7d4f;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.filter-arrow {
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 12rpx solid #2f7d4f;
  flex-shrink: 0;
}

/* ===== 数据卡片（形式同强化加成：指标名 + 数值 逐行展示） ===== */
.card {
  background: #fffdf8;
  border: 2rpx solid #e2d4b6;
  border-radius: 18rpx;
  padding: 8rpx 32rpx;
  box-shadow: 0 6rpx 24rpx rgba(120, 90, 40, 0.08);
}
.card-caption {
  padding: 22rpx 0 10rpx;
  font-family: "STKaiti", "KaiTi", "楷体", serif;
  font-size: 28rpx;
  color: #8a5a2b;
  text-align: center;
  letter-spacing: 1rpx;
}
.card-row {
  display: flex;
  align-items: baseline;
  padding: 22rpx 0;
  border-bottom: 2rpx dashed #e8ddc6;
  font-size: 30rpx;
}
.card-row:last-child {
  border-bottom: none;
}
.row-label {
  width: 300rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: #8a7355;
}
.row-sep {
  color: #b9a888;
  margin-right: 6rpx;
}
.row-value {
  flex: 1;
  color: #2f261d;
  font-weight: 600;
  font-family: "STKaiti", "KaiTi", "楷体", serif;
  word-break: break-all;
}

/* ===== 说明弹窗 ===== */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(40, 30, 20, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  padding: 60rpx;
}
.dialog {
  width: 100%;
  background: #fbf6ea;
  border: 2rpx solid #d9c9a8;
  border-radius: 20rpx;
  padding: 40rpx 36rpx 32rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.25);
}
.dialog-title {
  text-align: center;
  font-family: "STKaiti", "KaiTi", "楷体", serif;
  font-size: 30rpx;
  color: #9c2b2b;
  letter-spacing: 2rpx;
  margin-bottom: 18rpx;
}
.dialog-h {
  text-align: center;
  font-family: "STKaiti", "KaiTi", "楷体", serif;
  font-size: 40rpx;
  font-weight: 700;
  color: #3a2f25;
  margin-bottom: 8rpx;
}
.dialog-sub {
  text-align: center;
  font-size: 26rpx;
  color: #8a7355;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #e8ddc6;
}
.dialog-section {
  display: flex;
  margin-bottom: 18rpx;
}
.dialog-section .num {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
  background: #9c2b2b;
  color: #fff;
  font-size: 24rpx;
  margin-right: 16rpx;
}
.dialog-section .txt {
  flex: 1;
  font-size: 28rpx;
  color: #4a3d2e;
  line-height: 1.7;
}
.dialog-close {
  margin-top: 16rpx;
  text-align: center;
  background: #9c2b2b;
  color: #fff;
  border-radius: 40rpx;
  padding: 18rpx 0;
  font-size: 30rpx;
  letter-spacing: 4rpx;
}
.dialog-close:active {
  opacity: 0.85;
}

/* ===== 底部悬浮原生模板广告位（固定底部，不随内容滚动） ===== */
.ad-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  padding: 0 20rpx;
  padding-bottom: env(safe-area-inset-bottom, 0rpx);
  background: #efe5d2;
}
