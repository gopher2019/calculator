<!--babyskill.wxml-->
<view class="equip-page" style="padding-bottom: {{adReserve}}rpx;">
  <view class="header">
    <view class="title">宝宝技能概率查询</view>
    <view class="help-btn" bindtap="openHelp">说明</view>
  </view>

  <view class="filter-row">
    <picker class="filter-picker half" mode="selector" range="{{skillTypeOptions}}" value="{{skillTypeIndex}}" bindchange="onSkillTypeChange">
      <view class="filter-box">
        <text class="filter-label">技能类型</text>
        <text class="filter-value">{{skillTypeOptions[skillTypeIndex]}}</text>
        <view class="filter-arrow"></view>
      </view>
    </picker>
    <picker class="filter-picker half" mode="selector" range="{{charOptions}}" value="{{charIndex}}" bindchange="onCharChange">
      <view class="filter-box">
        <text class="filter-label">宝宝性格</text>
        <text class="filter-value">{{charOptions[charIndex]}}</text>
        <view class="filter-arrow"></view>
      </view>
    </picker>
  </view>

  <view class="table-card">
    <view class="table-scroll">
      <view class="table">
        <view class="table-row table-head">
          <view class="cell {{index === 0 ? 'label-cell' : ''}}" wx:for="{{columns}}" wx:for-item="col" wx:key="key">{{col.label}}</view>
        </view>
        <view class="table-row {{activeRow === ri ? 'active' : ''}}" wx:for="{{rows}}" wx:for-item="row" wx:for-index="ri" wx:key="rid" data-index="{{ri}}" bindtap="onRowTap">
          <view class="cell {{index === 0 ? 'label-cell' : ''}}" wx:for="{{columns}}" wx:for-item="col" wx:key="key">{{row[col.key]}}</view>
        </view>
      </view>
    </view>
  </view>
</view>

<!-- 底部悬浮原生模板广告位（固定底部，不随内容滚动） -->
<view class="ad-footer" hidden="{{adHidden}}">
  <ad class="ad-card" unit-id="adunit-e829ed82e8292f29" ad-type="card" ad-theme="light" bindload="onAdLoad" binderror="onAdError"></ad>
</view>

<!-- 说明弹窗（子弹窗浮层） -->
<view class="mask" wx:if="{{showHelp}}" bindtap="closeHelp">
  <view class="dialog" catchtap="noop">
    <view class="dialog-title">墨狐小算 · 说明</view>
    <view class="dialog-h">珍兽技能概率</view>
    <view class="dialog-sub">适用条件与使用说明</view>
    <view class="dialog-section">
      <text class="num">01</text>
      <text class="txt">数据为个人分析整理，不代表官方真实数据，仅供参考。</text>
    </view>
    <view class="dialog-section">
      <text class="num">02</text>
      <text class="txt">被动技能为主动攻击或挨打时效果触发概率；主动技能为技能未进入冷却时的主动释放概率。</text>
    </view>
    <view class="dialog-section">
      <text class="num">03</text>
      <text class="txt">“5星套增幅”是相对加成幅度，不是最终发动几率。例如：高级反击的胆小几率为15%，5星套增幅为50%，套后为15%×(1+50%)=22.5%。空白格表示暂无数据。</text>
    </view>
    <view class="dialog-section">
      <text class="num">04</text>
      <text class="txt">经验估计：1星套额外加成5%，每升1星再提高5%，5星共25%；不同技能可能有差别，不能据此确定其他星级的真实概率。</text>
    </view>
    <view class="dialog-section">
      <text class="num">05</text>
      <text class="txt">伤害说明：猛击套和痛击套为增伤，不享受暴击。1星增伤2000，每升1星增加1400，5星7600，打怪伤害×5。</text>
    </view>
    <view class="dialog-section">
      <text class="num">06</text>
      <text class="txt">高级摔绊的胆小5星套后数值为8；高级破御的5星套后数值暂无数据。</text>
    </view>
    <view class="dialog-close" bindtap="closeHelp">关闭</view>
  </view>
</view>
