<!--mine.wxml-->
<scroll-view class="scrollarea" scroll-y>
  <view class="page-container">

    <view class="map-tabs">
      <view
        class="map-tab {{index === activeIndex ? 'active' : ''}}"
        wx:for="{{maps}}"
        wx:key="name"
        data-index="{{index}}"
        bindtap="selectMap"
      >{{item.name}}</view>
    </view>

    <view class="section">
      <view class="map-image-wrap">
        <image wx:if="{{activeImage}}" class="map-image" src="{{activeImage}}" mode="widthFix" show-menu-by-longpress="{{true}}"></image>
        <view wx:elif="{{imageError}}" class="map-image-empty">{{imageError}}</view>
        <view wx:else class="map-image-empty">地图图片加载中…</view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">{{activeName}}挖矿坐标（分左右点击复制）</view>
      <view class="coord-grid">
        <view class="coord-item" wx:for="{{activeCoords}}" wx:key="index">
          <text class="coord-side coord-left" data-value="{{item.x}}" bindtap="copySide">({{item.x}}</text>
          <text class="coord-sep">,</text>
          <text class="coord-side coord-right" data-value="{{item.y}}" bindtap="copySide">{{item.y}})</text>
        </view>
      </view>
    </view>

  </view>
</scroll-view>
