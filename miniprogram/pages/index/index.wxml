<!--index.wxml-->
<image class="page-bg" src="/images/home-bg.png" mode="aspectFill"></image>

<view class="hero-inner">
  <view class="hero-name">{{nickname || '初来乍到'}}</view>
  <text class="hero-id" wx:if="{{userId}}">#{{userId}}</text>
  <text class="hero-sep">｜</text>
  <text class="hero-tag">怀旧天龙少侠的实用小工具</text>
</view>
<view class="hero-seal">墨狐</view>

<view class="container">
    <view class="tool-list">
      <view class="tool-card" bindtap="goToGameRecord">
        <view class="tool-icon">🏕️</view>
        <view class="tool-info">
          <text class="tool-name">回归与挂机设置</text>
          <text class="tool-desc">多账号卡回归计时、野外挂机时长管理</text>
        </view>
        <text class="tool-arrow">›</text>
      </view>
      <view class="tool-card" bindtap="goToSect">
        <view class="tool-icon">🛡️</view>
        <view class="tool-info">
          <text class="tool-name">门派属性系数</text>
          <text class="tool-desc">全门派冰火玄毒、力量灵气体力身法成长查询</text>
        </view>
        <text class="tool-arrow">›</text>
      </view>
      <view class="tool-card" bindtap="goToBeastCalc">
        <view class="tool-icon">🦁</view>
        <view class="tool-info">
          <text class="tool-name">资质计算器</text>
          <text class="tool-desc">珍兽当前资质 / 裸资质一键换算</text>
        </view>
        <text class="tool-arrow">›</text>
      </view>
      <view class="tool-card" bindtap="goToGrowthCalc">
        <view class="tool-icon">📈</view>
        <view class="tool-info">
          <text class="tool-name">成长率计算器</text>
          <text class="tool-desc">输入血量，反推珍兽成长档次</text>
        </view>
        <text class="tool-arrow">›</text>
      </view>
      <view class="tool-card" bindtap="goToWeaponCalc">
        <view class="tool-icon">🗡️</view>
        <view class="tool-info">
          <text class="tool-name">暗器星级计算</text>
          <text class="tool-desc">五项属性与修炼等级换算暗器星级</text>
        </view>
        <text class="tool-arrow">›</text>
      </view>
      <view class="tool-card" bindtap="goToMine">
        <view class="tool-icon">⛏️</view>
        <view class="tool-info">
          <text class="tool-name">挖矿坐标</text>
          <text class="tool-desc">西湖、洱海等地图挖矿点位一览</text>
        </view>
        <text class="tool-arrow">›</text>
      </view>
      <view class="tool-card" bindtap="goToXiaoxiao">
        <view class="tool-icon">⚔️</view>
        <view class="tool-info">
          <text class="tool-name">门派宵小坐标</text>
          <text class="tool-desc">慕容、恶人谷等分时段点位</text>
        </view>
        <text class="tool-arrow">›</text>
      </view>
      <view class="tool-card" bindtap="goToWuHun">
        <view class="tool-icon">🔮</view>
        <view class="tool-info">
          <text class="tool-name">武魂扩展属性</text>
          <text class="tool-desc">属性攻击/抗性/减抗/下限计算</text>
        </view>
        <text class="tool-arrow">›</text>
      </view>
      <view class="tool-card" bindtap="goToTeam">
        <view class="tool-icon">👥</view>
        <view class="tool-info">
          <text class="tool-name">队伍等级计算</text>
          <text class="tool-desc">输入队员等级，反推副本等级</text>
        </view>
        <text class="tool-arrow">›</text>
      </view>
      <view class="tool-card" bindtap="goToExp">
        <view class="tool-icon">⭐</view>
        <view class="tool-info">
          <text class="tool-name">升级经验计算</text>
          <text class="tool-desc">当前到目标等级所需经验</text>
        </view>
        <text class="tool-arrow">›</text>
      </view>
      <view class="tool-card" bindtap="goToHandcraft">
        <view class="tool-icon">🎨</view>
        <view class="tool-info">
          <text class="tool-name">手工DIY</text>
          <text class="tool-desc">每日制作鉴定专属手工</text>
        </view>
        <text class="tool-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="disclaimer">本工具仅玩家自制数据计算辅助工具，与游戏厂商无关联，数据仅供参考。</view>
