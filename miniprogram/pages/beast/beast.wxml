<!--beast.wxml-->
<scroll-view class="scrollarea" scroll-y>
  <view class="page-container">

    <!-- 顶部原生模板广告位 -->
    <view class="ad-slot ad-slot-top" hidden="{{adHiddenTop}}" style="min-height: {{adReserveTop}}rpx;">
      <ad unit-id="adunit-ad9ee36f107e0d79" ad-type="card" ad-theme="light" bindload="onAdLoad" binderror="onAdError" data-slot="top"></ad>
    </view>

    <view class="page-intro">怀旧天龙珍兽当前资质 / 裸资质一键换算，养宠更省心。</view>

    <view class="section">
      <view class="section-title">当前资质信息</view>

      <view class="input-group">
        <view class="input-label">当前资质</view>
        <input class="input-field" type="digit" placeholder="请输入当前资质" value="{{currentAptitude}}" bindinput="onAptitudeInput" />
      </view>

      <view class="input-group">
        <view class="input-label">当前悟性</view>
        <picker mode="selector" range="{{wuXingOptions}}" range-key="label" value="{{currentWuXing}}" bindchange="onCurrentWuXingChange">
          <view class="picker-field">
            <text>{{currentWuXing}}级</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>

      <view class="input-group">
        <view class="input-label">当前灵性</view>
        <picker mode="selector" range="{{lingXingOptions}}" range-key="label" value="{{currentLingXing}}" bindchange="onCurrentLingXingChange">
          <view class="picker-field">
            <text>{{currentLingXing}}级</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>
    </view>

    <view class="section">
      <view class="section-title">目标资质信息</view>

      <view class="input-group">
        <view class="input-label">目标悟性</view>
        <picker mode="selector" range="{{wuXingOptions}}" range-key="label" value="{{targetWuXing}}" bindchange="onTargetWuXingChange">
          <view class="picker-field">
            <text>{{targetWuXing}}级</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>

      <view class="input-group">
        <view class="input-label">目标灵性</view>
        <picker mode="selector" range="{{lingXingOptions}}" range-key="label" value="{{targetLingXing}}" bindchange="onTargetLingXingChange">
          <view class="picker-field">
            <text>{{targetLingXing}}级</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>

      <view class="input-group">
        <view class="switch-row" bindtap="onToggleSuperLing">
          <view class="switch-label">
            <text>是否超灵</text>
            <text class="switch-hint">（灵性8/9/10级生效：超灵比普通高2%）</text>
          </view>
          <view class="switch-track {{isSuperLing ? 'active' : ''}}">
            <view class="switch-thumb {{isSuperLing ? 'active' : ''}}"></view>
          </view>
        </view>
      </view>
    </view>

    <view class="btn-group">
      <button class="btn btn-primary" bindtap="onCalculate">计算资质</button>
      <button class="btn btn-secondary" bindtap="onReset">重置</button>
    </view>

    <view class="section result-section" wx:if="{{showResult && result}}">
      <view class="section-title">计算结果</view>
      <view class="result-card">
        <view class="result-row highlight">
          <text class="result-label">目标资质</text>
          <text class="result-value primary">{{result.targetAptitude}}</text>
        </view>
        <view class="result-divider"></view>
        <view class="result-row">
          <text class="result-label">当前总倍率</text>
          <text class="result-value">{{result.totalCurrentRateStr}}</text>
        </view>
        <view class="result-row">
          <text class="result-label">悟性加成</text>
          <text class="result-value">{{result.wuXingRateChangeStr}}</text>
        </view>
        <view class="result-row">
          <text class="result-label">灵性加成</text>
          <text class="result-value">{{result.lingXingRateChangeStr}}</text>
        </view>
        <view class="result-divider"></view>
        <view class="result-row">
          <text class="result-label">基础资质</text>
          <text class="result-value">{{result.baseAptitude}}</text>
        </view>
        <view class="result-row highlight-gain">
          <text class="result-label">资质提升</text>
          <text class="result-value gain">{{result.aptitudeGainStr}}</text>
        </view>
      </view>
    </view>

    <!-- 原生模板广告位（等级倍率参考表上方；位于计算结果下方，以正常文档流渲染，不会遮挡计算结果） -->
    <view class="ad-slot ad-slot-mid" hidden="{{adHiddenMid}}" style="min-height: {{adReserveMid}}rpx;">
      <ad unit-id="adunit-ad9ee36f107e0d79" ad-type="card" ad-theme="light" bindload="onAdLoad" binderror="onAdError" data-slot="mid"></ad>
    </view>

    <view class="section rate-table-section">
      <view class="section-title rate-table-header" bindtap="onToggleRateTable">
        <text>等级倍率参考表</text>
        <text class="toggle-icon">{{showRateTable ? '▼' : '▶'}}</text>
      </view>
      <view class="rate-table-content" wx:if="{{showRateTable}}">
        <view class="rate-tabs">
          <view class="rate-tab {{activeRateTab === 'wuxing' ? 'active' : ''}}" data-tab="wuxing" bindtap="onSwitchRateTab">悟性倍率</view>
          <view class="rate-tab {{activeRateTab === 'lingxing' ? 'active' : ''}}" data-tab="lingxing" bindtap="onSwitchRateTab">灵性倍率</view>
        </view>
        <view class="rate-table" wx:if="{{activeRateTab === 'wuxing'}}">
          <view class="rate-table-row rate-table-header-row">
            <text class="rate-cell">等级</text>
            <text class="rate-cell">倍率</text>
          </view>
          <view class="rate-table-row" wx:for="{{wuXingRateTable}}" wx:key="level">
            <text class="rate-cell">{{item.level}}级</text>
            <text class="rate-cell">{{item.rateStr}}</text>
          </view>
        </view>
        <view class="rate-table" wx:if="{{activeRateTab === 'lingxing'}}">
          <view class="rate-table-row rate-table-header-row">
            <text class="rate-cell col-level">等级</text>
            <text class="rate-cell">普通倍率</text>
            <text class="rate-cell">超灵倍率</text>
          </view>
          <view class="rate-table-row {{item.differ ? 'super-row' : ''}}" wx:for="{{lingXingRateTable}}" wx:key="level">
            <text class="rate-cell col-level">{{item.level}}级</text>
            <text class="rate-cell">{{item.normalRateStr}}</text>
            <text class="rate-cell {{item.differ ? 'super-cell' : 'super-cell-same'}}">{{item.differ ? item.superRateStr : '—'}}</text>
          </view>
          <view class="rate-table-note">注：超灵仅在灵性 8/9/10 级生效，其余等级与普通一致。</view>
        </view>
      </view>
    </view>

    <view class="bottom-spacer"></view>
  </view>
</scroll-view>
